datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model ClassSession {
  id        Int      @id @default(autoincrement())
  time      String
  name      String
  coach     String
  category  String
}

model MemberRegistration {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  planName  String
  createdAt DateTime @default(now())
}

model Trainer {
  id          Int      @id @default(autoincrement())
  name        String
  specialty   String
  pr          String
  bio         String
  image       String
}

model MembershipPlan {
  id          Int      @id @default(autoincrement())
  name        String
  price       String
  perks       String
}

model ShopProduct {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       Float
  image       String
}

model Transformation {
  id          Int      @id @default(autoincrement())
  memberName  String
  achievement String
  image       String
}

model ProgressLog {
  id          Int      @id @default(autoincrement())
  memberName  String
  weight      Float
  bodyFat     Float
  date        String
}
